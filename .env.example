# ---------- App ----------
# Public base URL of your deployment (used for Stripe redirects, auth callbacks,
# canonical URLs, sitemap, and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Service role key (server only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Anthropic (name brainstorming + web research) ----------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the base URL / model. Sonnet 4.6 is the cost-effective
# default for web-search research; set claude-opus-4-8 for higher quality.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cap on web searches per research call. Bounds cost-of-goods per credit
# (each search ~= $0.01). Lower = cheaper & faster, higher = more thorough.
ANTHROPIC_MAX_WEB_SEARCHES=10

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
