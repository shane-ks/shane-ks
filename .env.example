# ---------- App ----------
# Public base URL of your deployment (used for Stripe redirects + auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Service role key (server only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Anthropic (name brainstorming + web research) ----------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the base URL / model
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the $10 lifetime pass (one-time payment). Optional —
# if unset the checkout session is created with an inline $10 price.
STRIPE_LIFETIME_PRICE_ID=

# ---------- Product config ----------
# How many free searches before a lifetime pass is required
NEXT_PUBLIC_FREE_SEARCH_LIMIT=3
